# Copy this file to `.env` for local development, or set these as real
# environment variables in your hosting platform. Do not commit a real
# `.env` file with secrets.

# General
FIADOBOT_APP_NAME=fiadobot
FIADOBOT_ENV=development
FIADOBOT_LOG_LEVEL=INFO

# Database (SQLAlchemy connection string, must use the psycopg driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fiadobot

# LLM provider
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Optional but recommended: secret Telegram sends back on every webhook call
# (configured when calling setWebhook) so the endpoint can reject spoofed
# requests.
TELEGRAM_WEBHOOK_SECRET=

# Only used by the container entrypoint; most PaaS providers inject this
# automatically.
PORT=8000
